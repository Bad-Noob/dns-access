[Unit]
Description=DNS Access Service
After=network-online.target nftables.service nginx.service
Wants=network-online.target
Requires=nftables.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/dns-access
EnvironmentFile=-/etc/dns-access.conf
ExecStart=/opt/dns-access/venv/bin/python /opt/dns-access/app/app.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/dns-access /etc/nginx
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
