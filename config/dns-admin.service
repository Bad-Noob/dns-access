[Unit]
Description=DNS Access Administration Panel
After=network-online.target dns-access.service
Wants=network-online.target
Requires=dns-access.service

[Service]
Type=simple

User=root
Group=root

WorkingDirectory=/opt/dns-admin

EnvironmentFile=/etc/dns-admin.env
EnvironmentFile=-/etc/dns-access.conf

ExecStart=/opt/dns-admin/venv/bin/python /opt/dns-admin/app/app.py

Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

ReadWritePaths=/opt/dns-access/data
ReadWritePaths=/etc/nginx

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
