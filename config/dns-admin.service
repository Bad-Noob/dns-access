[Unit]
Description=DNS Access Administration Panel
After=network-online.target dns-access.service
Wants=network-online.target
Requires=dns-access.service

[Service]
Type=simple

User=root
Group=root

WorkingDirectory=/opt/dns-admin

EnvironmentFile=/etc/dns-admin.env
EnvironmentFile=-/etc/dns-access.conf

ExecStart=/opt/dns-admin/venv/bin/gunicorn --chdir /opt/dns-admin/app --workers 2 --bind 0.0.0.0:8790 app:app

Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

ReadWritePaths=/opt/dns-access/data

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
