[Unit]
Description=Recursive DNS Resolver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unbound
Group=unbound

ExecStart=/usr/sbin/unbound -d -c /etc/unbound/unbound.conf

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

RuntimeDirectory=unbound
RuntimeDirectoryMode=0750

ReadOnlyPaths=/etc/unbound
ReadWritePaths=/var/lib/unbound /run/unbound

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
